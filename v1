      for (const id of ids) { const p = X.P.get(id); if (!p) continue; const r = week(p, wk); cap += r.cap; conf += r.conf; tent += r.tent; off += r.off; }
      return tipNode(`Team · ${wkRange(wk)}`, [[`${fmt1(conf)} h`, 'Confirmed', '--s-conf'], [`${fmt1(tent)} h`, 'Tentative', '--s-tent'], [`${fmt1(cap - conf - tent)} h`, 'Free', null]], `${fmtPct(cap ? (conf + tent) / cap : null)} of ${fmt1(cap)} available hours${off ? ` · ${plural(off, 'person-day')} off` : ''}`);
    }
