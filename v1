function staffing(pr) {
  return memo('staff|' + pr.id, () => {
    const X = ix();
    const roles = X.byProject.get(pr.id) || [];
    const cur = roles.filter(a => a.e == null || a.e >= X.T);
    const set = cur.length ? cur : roles;
