      for (const e of r.proj) rows.push([`${fmt1(e.h)} h`, e.a.project.name, null]);
      const foot = [`${fmtPct(r.util)} of ${fmt1(r.cap)} available hours`, r.off ? `${plural(r.off, 'day')} off (${r.offTypes.join(', ')})` : '', r.outside ? 'Some bookings fall outside their contract dates' : ''].filter(Boolean).join(' · ');
      return tipNode(title, rows, foot);
    }
    case 'tw': {
