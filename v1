  const roles = (X.byPerson.get(p.id) || []).slice();
  const cur = roles.filter(a => a.e == null || a.e >= X.T);
  const past = roles.filter(a => a.e != null && a.e < X.T).sort((a, b) => b.e - a.e).slice(0, 4);
  const roleRow = a => {
