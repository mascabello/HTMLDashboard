// ===================================================================
// State
// ===================================================================
const S = Object.fromEntries(COLLS.map(c => [c, new Map()]));
const app = {
  mode: 'connecting',   // connecting | shared | local
  ready: false,
  stale: false,
  canWrite: null,       // true | false | null (unknown)
  version: 0,
  seen: new Set(),
  live: new Set(),
  view: 'dashboard',
  f: {
    dash: { weeks: 12, team: '' },
    people: { q: '', team: '', skill: '', min: 1, type: '', sort: 'name' },
    projects: { q: '', status: 'open' },
    skills: { tab: 'matrix', team: '', cat: '', q: '' },
    avail: { offset: 0, weeks: 12, team: '', skill: '', min: 1, q: '', metric: 'util' },
