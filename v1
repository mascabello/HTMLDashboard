      <div class="d"><span class="num">${a.alloc}%</span><span class="num">${fdr(a.s, a.e)}</span>${sk ? `<span>${esc(sk.name)}${a.minLevel ? `, ${LEVELS[a.minLevel]}+` : ''}</span>` : ''}${a.booking === 'Tentative' ? pill('neutral', 'Tentative') : ''}${below ? pill('warn', 'Below required level', 'alert') : ''}</div></div>
