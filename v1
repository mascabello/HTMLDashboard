function roundTop(x, y, w, h, r) {
  const f = v => v.toFixed(1);
  return `M${f(x)} ${f(y + h)}V${f(y + r)}Q${f(x)} ${f(y)} ${f(x + r)} ${f(y)}H${f(x + w - r)}Q${f(x + w)} ${f(y)} ${f(x + w)} ${f(y + r)}V${f(y + h)}Z`;
}
function stackChart(el, cfg) {
  const { series, showOpen, noCap } = cfg;
  const X = ix();
  const W = Math.max(260, Math.floor(el.getBoundingClientRect().width || 600));
  const H = cfg.height || 236;
  const m = { t: 12, r: 6, b: 38, l: 44 };
  const iw = W - m.l - m.r, ih = H - m.t - m.b;
  const n = series.length;
  if (!n) { el.innerHTML = ''; return; }
  const vmax = Math.max(1, ...series.map(s => Math.max(s.conf + s.tent + (showOpen ? s.open : 0), noCap ? 0 : s.cap)));
  const sc = niceScale(vmax);
  const y = v => m.t + ih - v / sc.max * ih;
  const band = iw / n;
  const bw = Math.min(24, Math.max(4, band * 0.58));
  let out = '';
  out += series.map((s, i) => `<rect class="hit" x="${(m.l + band * i).toFixed(1)}" y="${m.t}" width="${band.toFixed(1)}" height="${ih}" tabindex="0" data-tip="cap:${cfg.id}:${i}" aria-label="${esc(chartAria(s, cfg))}"></rect>`).join('');
  for (const t of sc.ticks) {
    const yy = y(t).toFixed(1);
    out += `<line class="${t === 0 ? 'bl' : 'gl'}" x1="${m.l}" x2="${W - m.r}" y1="${yy}" y2="${yy}"></line><text class="ax" x="${m.l - 8}" y="${yy}" text-anchor="end" dominant-baseline="middle">${fmtInt(t)}</text>`;
  }
  const every = Math.max(1, Math.ceil(46 / band));
  series.forEach((s, i) => {
    const x0 = m.l + band * i + (band - bw) / 2;
    const segs = [['var(--s-conf)', s.conf], ['var(--s-tent)', s.tent], ['var(--s-open)', showOpen ? s.open : 0]].filter(g => g[1] > 0.05);
    let base = 0;
    segs.forEach((g, k) => {
      const top = base + g[1];
      const y1 = y(top), y0 = y(base) - (k > 0 ? 2 : 0);
      const h = y0 - y1;
      if (h > 0.4) {
        out += k === segs.length - 1
          ? `<path d="${roundTop(x0, y1, bw, h, Math.min(4, h, bw / 2))}" style="fill:${g[0]}"></path>`
          : `<rect x="${x0.toFixed(1)}" y="${y1.toFixed(1)}" width="${bw.toFixed(1)}" height="${h.toFixed(1)}" style="fill:${g[0]}"></rect>`;
      }
      base = top;
    });
    if (i % every === 0) {
      const cx = (m.l + band * (i + 0.5)).toFixed(1);
      out += `<text class="axw${s.wk === X.W0 ? ' now' : ''}" x="${cx}" y="${H - m.b + 16}" text-anchor="middle">${wkCode(s.wk)}</text><text class="ax" x="${cx}" y="${H - m.b + 30}" text-anchor="middle">${fd(s.wk, false)}</text>`;
    }
  });
  if (!noCap) {
    const pts = series.map((s, i) => [m.l + band * (i + 0.5), y(s.cap)]);
    if (n > 1) out += `<path class="capline" d="${pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' ')}"></path>`;
    out += pts.map(p => `<circle class="capdot" cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="4"></circle>`).join('');
  }
  el.innerHTML = `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" role="group" aria-label="${esc(cfg.title)}">${out}</svg>`;
}
function chartAria(s, cfg) {
  const parts = [`${wkCode(s.wk)}`, `confirmed ${fmtInt(s.conf)} hours`, `tentative ${fmtInt(s.tent)} hours`];
  if (cfg.showOpen) parts.push(`open roles ${fmtInt(s.open)} hours`);
  if (!cfg.noCap) parts.push(`capacity ${fmtInt(s.cap)} hours`);
  return parts.join(', ');
}
function drawCharts(root = document) {
  for (const el of $$('[data-chart]', root)) { const c = CHARTS.get(el.dataset.chart); if (c) stackChart(el, c); }
}
function capTable(cfg) {
  const { series, showOpen, noCap } = cfg;
  return `<table class="data"><thead><tr><th scope="col">Week</th>${noCap ? '' : '<th scope="col">Capacity (h)</th>'}<th scope="col">Confirmed (h)</th><th scope="col">Tentative (h)</th>${showOpen ? '<th scope="col">Open roles (h)</th>' : ''}${noCap ? '' : '<th scope="col">Utilization</th>'}</tr></thead><tbody>${series.map(s => `<tr><td>${wkCode(s.wk)} · ${fd(s.wk, false)}</td>${noCap ? '' : `<td>${fmtInt(s.cap)}</td>`}<td>${fmtInt(s.conf)}</td><td>${fmtInt(s.tent)}</td>${showOpen ? `<td>${fmtInt(s.open)}</td>` : ''}${noCap ? '' : `<td>${fmtPct(s.cap ? (s.conf + s.tent) / s.cap : null)}</td>`}</tr>`).join('')}</tbody></table>`;
}
function chartLegend(cfg) {
  return `<div class="legend"><span><i class="sw" style="background:var(--s-conf)"></i>Confirmed</span><span><i class="sw" style="background:var(--s-tent)"></i>Tentative</span>${cfg.showOpen ? '<span><i class="sw" style="background:var(--s-open)"></i>Open roles</span>' : ''}${cfg.noCap ? '' : '<span><i class="sw line" style="background:var(--fg)"></i>Capacity</span>'}</div>`;
}

function timeline(list) {
  const X = ix();
  if (!list.length) return `<p class="empty-note">No projects to show.</p>`;
  const t = new Date(X.T);
  const y0 = t.getUTCFullYear(), m0 = t.getUTCMonth();
  const from = Date.UTC(y0, m0 - 1, 1), to = Date.UTC(y0, m0 + 8, 1);
  const span = to - from;
  const pct = ms => (clamp(ms, from, to) - from) / span * 100;
  const months = Array.from({ length: 9 }, (_, i) => Date.UTC(y0, m0 - 1 + i, 1));
  const axis = months.map(ms => { const d = new Date(ms); return `<span style="left:${pct(ms).toFixed(2)}%">${MON[d.getUTCMonth()]}${d.getUTCMonth() === 0 ? ' ' + d.getUTCFullYear() : ''}</span>`; }).join('');
  const grid = months.map(ms => `<i style="left:${pct(ms).toFixed(2)}%"></i>`).join('') + `<i class="today" style="left:${pct(X.T).toFixed(2)}%"><b>Today</b></i>`;
  const rows = list.map(pr => {
    const st = staffing(pr);
    const s = pr.start ?? X.T, e = pr.end ?? s;
    const visible = e >= from && s < to;
    const l = pct(s), r = pct(e + DAY);
    const cls = { Active: '', Planned: 'planned', 'On hold': 'hold', Completed: 'done' }[pr.status] || '';
    const bar = visible ? `<span class="tl-bar ${cls}${s < from ? ' cut-l' : ''}${e + DAY > to ? ' cut-r' : ''}" style="left:${l.toFixed(2)}%;width:${Math.max(0.6, r - l).toFixed(2)}%">${st.open.length && COUNTS.has(pr.status) ? '<i class="openmark"></i>' : ''}</span>` : '';
    return `<button type="button" class="tl-row" data-act="open-project" data-id="${esc(pr.id)}" data-tip="tl:${esc(pr.id)}">
      <span class="tl-label"><strong>${esc(pr.name)}</strong><span class="meta">${pr.code ? `<span class="mono">${esc(pr.code)}</span>` : ''}${statusPill(pr.status)}${COUNTS.has(pr.status) && st.state !== 'good' ? staffPill(st) : ''}</span></span>
      <span class="tl-track">${bar}</span></button>`;
  }).join('');
  return `<div class="tl"><div class="tl-axis" aria-hidden="true"><span></span><div class="tl-axis-track">${axis}</div></div><div class="tl-body"><div class="tl-grid" aria-hidden="true">${grid}</div>${rows}</div></div>`;
}

