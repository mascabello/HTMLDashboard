  const facts = [['Lead', lead ? lead.name : '—'], ['Sponsor', pr.sponsor || '—'], ['Dates', fdr(pr.start, pr.end)], ['Priority', pr.priority], ['Staffing', `${fmt1(st.filled)} of ${fmt1(st.total)} FTE filled`], ['Open roles', String(st.open.length)]];
  return drawerHead(esc(pr.name), `${pr.code ? `<span class="mono">${esc(pr.code)}</span> · ` : ''}${statusPill(pr.status)} ${COUNTS.has(pr.status) ? staffPill(st) : ''}`,
